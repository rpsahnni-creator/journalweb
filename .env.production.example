APP_NAME="SRT Journal of Multidisciplinary Research"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://journal.srtc.ac.in
APP_KEY=
# Generate once on the server: php artisan key:generate --force
# Never regenerate after real data exists.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared hosting usually has no queue worker. Use sync so mail sends in-request.
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# College SMTP or a transactional provider (Brevo, SendGrid, etc.).
# Password reset and email verification will not work until this is real.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=journal@srtc.ac.in
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TEST_ENABLED=false

# Used only by `php artisan admin:create`. Leave ADMIN_PASSWORD empty
# so the command prompts on the server. Do not run db:seed --class=DatabaseSeeder.
ADMIN_EMAIL=journal@srtc.ac.in

CROSSREF_PREFIX=
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME="SRT Journal of Multidisciplinary Research"
CROSSREF_DEPOSITOR_EMAIL=journal@srtc.ac.in
