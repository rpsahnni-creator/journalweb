APP_NAME="SRT Journal of Multidisciplinary Research"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://journal.srtc.ac.in
APP_KEY=
# Generate once with `php artisan key:generate` on first deploy only —
# never regenerate after real data exists, it will break encrypted data.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Fill MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD with whichever SMTP provider
# is chosen (college mail server, or a transactional provider like Brevo/
# SendGrid) — these placeholders work with any standard SMTP provider
# without further code changes.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=journal@srtc.ac.in
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=
# Used once by `php artisan admin:create` after first deploy — do not set
# ADMIN_PASSWORD here; the command will prompt for it securely instead.

# CrossRef DOI prefix after membership is approved. Must look like 10.12345 —
# never use a placeholder such as 10.XXXX. Leave empty until then.
CROSSREF_PREFIX=
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME="SRT Journal of Multidisciplinary Research"
CROSSREF_DEPOSITOR_EMAIL=journal@srtc.ac.in
