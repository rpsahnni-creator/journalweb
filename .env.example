APP_NAME="Academic Journal"
# journal.srtc.ac.in must use APP_ENV=production. Never deploy with APP_ENV=local.
APP_ENV=local
APP_KEY=
# journal.srtc.ac.in must use APP_DEBUG=false. Debug mode left on leaks stack traces and file paths.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=journal_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local mail testing (never commit real SMTP passwords).
# MAIL_MAILER=log writes messages to storage/logs instead of sending them.
# Before production, configure a real SMTP provider (college email or a
# transactional mail service such as Amazon SES, Mailgun, or Postmark):
# MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD.
# For Mailpit locally: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025.
# Enable only on local machines. Always leave false in production.
MAIL_TEST_ENABLED=false
MAIL_TEST_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave empty until a real CrossRef prefix is issued (10.NNNN). 10.XXXX is rejected.
CROSSREF_PREFIX=
CROSSREF_USERNAME=
CROSSREF_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
